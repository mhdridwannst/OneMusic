# Public Supabase project configuration (safe for NEXT_PUBLIC_* usage).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Public URL for the Supabase Storage bucket that contains MP3 files.
# Do not add a trailing slash.
NEXT_PUBLIC_AUDIO_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/music
